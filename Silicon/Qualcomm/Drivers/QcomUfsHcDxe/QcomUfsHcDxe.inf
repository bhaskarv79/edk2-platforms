  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0MemBaseAddress
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0PostLinkCallbackEn
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0PowerModeReconfigEnable
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0PreHceCallbackEn
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0Rate
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0RefClkFreq
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0SkipHceReenable
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0SkipLinkStartup
