[Defines]
  INF_VERSION                    = 1.30
  BASE_NAME                      = QcomUfsHcDxe
  FILE_GUID                      = 9be976cc-5deb-4ea4-91f1-decdef6f492b
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = QcomUfsHcDriverEntry

[Sources]
  QcomUfsHcDxe.c
  UfsCore.c
  UfsDtGetConfig.c
  UfsGetConfig.c
  UfsHcPlatform.c
  UfsHostController.c
  UfsPhy.c
