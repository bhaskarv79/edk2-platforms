[Defines]
  INF_VERSION                    = 1.30
  BASE_NAME                      = QcomUfsHcDxe
  FILE_GUID                      = 9be976cc-5deb-4ea4-91f1-decdef6f492b
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = QcomUfsHcDriverEntry

[Sources]
  QcomUfsHcDxe.c
  QcomUfsHcDxe.h
  UfsCore.c
  UfsCore.h
  UfsDtGetConfig.c
  UfsDtGetConfig.h
  UfsGetConfig.c
  UfsGetConfig.h
  UfsHcPlatform.c
  UfsHcPlatform.h
  UfsPhy.c
  UfsPhy.h
  UfsUtils.c
  UfsUtils.h
  UfsUtpCore.c
  UfsUtpCore.h

[Packages]
  EmbeddedPkg/EmbeddedPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  Platform/Qualcomm/Common/QualcommCommonPlatformPkg/QualcommCommonPlatformPkg.dec
  Silicon/Qualcomm/Common/QualcommCommonSiliconPkg/QualcommCommonSiliconPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DxeServicesTableLib
  IoLib
  MemoryAllocationLib
  NonDiscoverableDeviceRegistrationLib
  PcdLib
  PrintLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gDtbExtnProtocolGuid                 ## SOMETIMES_CONSUMES ## NOTIFY
  gEdkiiUfsHcPlatformProtocolGuid      ## PRODUCES
  gEfiCpuArchProtocolGuid              ## CONSUMES
  gEfiExtScsiPassThruProtocolGuid      ## NOTIFY
  gEfiUfsDeviceConfigProtocolGuid      ## NOTIFY

[Guids]
  gEfiEndOfDxeEventGroupGuid           ## SOMETIMES_CONSUMES ## Event

[FixedPcd]
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0HciOffset
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0MemBaseAddress
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0PostLinkCallbackEn
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0PowerModeReconfigEnable
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0PreHceCallbackEn
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0RefClkFreq
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0SkipHceReenable
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0SkipLinkStartup
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfsConfigSourceDeviceTree

[Depex]
  #
  # UfsRegisterMmioRange() sets the HCI window uncached from the entry point,
  # which the GCD refuses until the CPU Architectural Protocol is installed.
  #
  gEfiCpuArchProtocolGuid
