  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  QualcommCommonPlatformPkg/QualcommCommonPlatformPkg.dec
  QualcommCommonSiliconPkg/QualcommCommonSiliconPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  CacheMaintenanceLib
  DebugLib
  DevicePathLib
  DmaLib
  DxeServicesTableLib
  IoLib
  MemoryAllocationLib
  PcdLib
  PrintLib
  SafeIntLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
