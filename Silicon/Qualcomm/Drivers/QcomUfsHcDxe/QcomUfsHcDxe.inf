[Defines]
  INF_VERSION                    = 1.30
  BASE_NAME                      = QcomUfsHcDxe
  FILE_GUID                      = 9be976cc-5deb-4ea4-91f1-decdef6f492b
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = QcomUfsHcDriverEntry

[Sources]
  QcomUfsHcDxe.c
  UfsCore.h
  UfsDtGetConfig.c
  UfsDtGetConfig.h
  UfsGetConfig.c
  UfsGetConfig.h
  UfsUtils.c
  UfsUtils.h

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Silicon/Qualcomm/QcomPlatformPkg/QcomPlatformPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  Platform/Qualcomm/Common/QualcommCommonPlatformPkg/QualcommCommonPlatformPkg.dec
  Silicon/Qualcomm/Common/QualcommCommonSiliconPkg/QualcommCommonSiliconPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DxeServicesTableLib
  IoLib
  MemoryAllocationLib
  NonDiscoverableDeviceRegistrationLib
  PcdLib
  PrintLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gDtbExtnProtocolGuid                 ## SOMETIMES_CONSUMES
  gEdkiiUfsHcPlatformProtocolGuid

[FixedPcd]
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0HciOffset
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0MemBaseAddress
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0PostLinkCallbackEn
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0PreHceCallbackEn
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0RefClkFreq
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0SkipHceReenable
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfs0SkipLinkStartup
  gQualcommCommonSiliconPkgTokenSpaceGuid.PcdUfsConfigSourceDeviceTree

[Pcd]
  gQcomPlatformTokenSpaceGuid.PcdQcomUfsHcDxeBaseAddress
  gQcomPlatformTokenSpaceGuid.PcdQcomUfsHcDxeSize

[Depex]
  TRUE
